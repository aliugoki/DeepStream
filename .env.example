# Copy to .env (which is gitignored) and fill in real values.
# The enterprise pipeline (utils/db_service.py) refuses to start without the
# three required secrets below.

# --- Database (point DB_HOST at pgbouncer for connection pooling) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=facial_recognition_db
DB_USER=postgres
DB_PASSWORD=                 # REQUIRED
DB_POOL_MIN=1
DB_POOL_MAX=4

# --- Webhook ---
WEBHOOK_URL=http://localhost:5001/api/add-entry
WEBHOOK_TOKEN=               # REQUIRED
WEBHOOK_VERIFY_TLS=true      # set false only for trusted local endpoints
WEBHOOK_TIMEOUT=10
WEBHOOK_RETRIES=3

# --- Tenant ---
COMPANY_ID=                  # REQUIRED (uuid)

# --- Attendance ---
ATTENDANCE_THROTTLE_SEC=30
